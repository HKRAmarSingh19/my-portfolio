# Client-side Google OAuth config. Copy this file to .env and set the value.
# This is the PUBLIC client id (it ships to the browser) — it matches the
# server's GOOGLE_CLIENT_ID; the corresponding secret stays in server/.env only.
# Leave blank to hide the "Continue with Google" button and keep password login.
VITE_GOOGLE_CLIENT_ID=111020564598-0lrf7e73hq22qgm2ffs7g369rn46mpd8.apps.googleusercontent.com

# API origin for the built app. In dev this is left blank so axios uses the
# Vite proxy's /api. When the frontend is deployed on its own origin (Vercel)
# and the API elsewhere (Render), set this to the API's public origin WITHOUT a
# trailing slash, e.g.
#   VITE_API_URL=https://portfolio-api.onrender.com
# The client appends '/api' automatically.
# VITE_API_URL=
