              "codecSettings": {
                "codec": "H_264",
                "h264Settings": {
                  "rateControlMode": "QVBR",
                  "qvbrSettings": {
                    "qvbrQualityLevel": 8,
                    "qvbrQualityLevelFineTune": 0.5
                  },
                  "maxBitrate": 800000,
                  "qualityTuningLevel": "SINGLE_PASS",
                  "gopSize": 2,
                  "gopSizeUnits": "SECONDS",
                  "interlaceMode": "PROGRESSIVE",
                  "repeatPps": "DISABLED"
                }
              }
            },
            "audioDescriptions": [
              {
