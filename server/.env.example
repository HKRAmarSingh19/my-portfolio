PORT=5000
NODE_ENV=development
# Local MongoDB by default. For permanent/cloud storage, use a MongoDB Atlas
# connection string instead, e.g.
#   mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/mern_portfolio?appName=...
# (If your Atlas password contains special chars like @ : / ? # it must be
# URL-encoded, e.g. an '@' becomes %40.)
MONGODB_URI=mongodb://127.0.0.1:27017/mern_portfolio

# REQUIRED — the server refuses to start without a strong secret (>= 16 chars).
# Replace with a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=<your-own-strong-random-secret>
JWT_EXPIRE=24h

ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=AdminPass123!

CLIENT_URL=http://localhost:5173

# --- Google OAuth (admin "Sign in with Google") ---
# Create an OAuth client in Google Cloud Console (Credentials > OAuth client ID,
# type "Web application"). Set the same Authorized JS origins + redirect URIs to
# your SPA origin (http://localhost:5173 in dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# The ONLY Google accounts allowed to sign in — a comma-separated list of the
# verified Google emails permitted. Any other Google account is rejected with
# 403. e.g. you@gmail.com, coadmin@gmail.com
ALLOWED_ADMIN_EMAILS=you@gmail.com


# --- AWS S3 (photos & videos storage) ---
# Media is uploaded to a PUBLIC-READ S3 bucket so the absolute returned URLs can
# be rendered by <img>/<video> on the public site. Create an IAM user with
# AmazonS3FullAccess and a bucket with a public-read policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=<your-bucket-name>


# --- Instagram Graph API (Instagram feed sync) ---
# Switch the IG account to a professional (Business/Creator) profile, create a
# Meta app with the Instagram Login product, and grant the instagram_basic
# scope. Exchange the short-lived code for a long-lived (60-day, refreshable)
# access token, and get the IG user id from the Meta Graph API explorer.
# Without these, the feed simply stays empty (feature is opt-in).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_API_VERSION=v22.0


# --- LinkedIn feed (manual curation, no credential needed) ---
# The LinkedIn tab is populated by pasting post URLs in the admin panel
# (/admin/linkedin) — nothing is fetched from LinkedIn automatically, so no
# token or app approval is required.
# LINKEDIN_VANITY_NAME is OPTIONAL — your public handle for the "View profile"
# link → https://www.linkedin.com/in/{vanity}.
LINKEDIN_VANITY_NAME=
